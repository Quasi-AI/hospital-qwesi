# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/ai-doc

# NextAuth Configuration
NEXTAUTH_SECRET=your-super-secret-key-change-this-in-production
NEXTAUTH_URL=http://localhost:3000

# Demo Mode (disable in production)
DEMO=false

# Realtime notification WebSocket server
REALTIME_PORT=3001
REALTIME_SECRET=change-this-to-a-long-random-secret
NEXT_PUBLIC_REALTIME_WS_PORT=3001
# NEXT_PUBLIC_REALTIME_WS_URL=wss://your-realtime-host/ws
# REALTIME_EMIT_URL=http://127.0.0.1:3001/emit

# ===================================
# Protocol Server Configuration
# ===================================

# Enable/disable protocol servers (set to false to disable)
PROTOCOL_SERVERS_ENABLED=true

# HL7 v2 Server Configuration
HL7_SERVER_ENABLED=true
HL7_SERVER_PORT=2575
HL7_SERVER_HOST=0.0.0.0
HL7_CONNECTION_TIMEOUT=300000
HL7_MESSAGE_TIMEOUT=30000
HL7_MAX_CONNECTIONS=100
HL7_AUTO_ACK=true

# ASTM E1381/E1394 Server Configuration
ASTM_SERVER_ENABLED=true
ASTM_SERVER_PORT=5000
ASTM_SERVER_HOST=0.0.0.0
ASTM_CONNECTION_TIMEOUT=300000
ASTM_FRAME_TIMEOUT=15000
ASTM_MAX_CONNECTIONS=50
ASTM_RETRY_COUNT=3
ASTM_CHECKSUM_ENABLED=true

# FHIR R4 Endpoints (served via Next.js API, always enabled)
# Endpoints:
#   POST /api/fhir/DiagnosticReport
#   POST /api/fhir/Observation
#   POST /api/fhir/Bundle

# Twilio (optional; usually stored in Admin → Notification Settings)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+1...   # From number if not using a Messaging Service
# TWILIO_MESSAGING_SERVICE_SID=MG...   # Preferred for multi-region; add senders in Twilio Console

# SMTP fallback for credential emails (Admin -> Notification Settings can override)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USERNAME=info@example.com
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=info@example.com
# SMTP_FROM_NAME=Qwesi Virtual Hospital

# Optional doctor/staff license verification registry API.
# When configured, profile uploads and admin "Auto-check" call this endpoint.
# Expected truthy response examples: { "valid": true }, { "verified": true }, or { "status": "verified" }.
# LICENSE_VERIFICATION_API_URL=https://registry.example.gov/api/verify-license
# LICENSE_VERIFICATION_API_KEY=

# Qwesi AI backend (WhatsApp/Facebook brain, credits, voice) used by the My AI Doctor video call
QWESI_BACKEND_URL=https://your-backend.onrender.com
# HOSPITAL_DASHBOARD_API_KEY must match the backend value

# --- Scheduled emails (profile reminders, missed consultations, patient check-ins) ---
# Call GET /api/cron/lifecycle once a day from any scheduler with header "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# LIFECYCLE_IN_APP=false        # set to false to turn off the built-in fallback that also runs these every 6h
# PATIENT_CHECKIN_AFTER_DAYS=14 # patient not logged in for this long gets a check-in email
# PATIENT_CHECKIN_EVERY_DAYS=30
# PROFILE_REMINDER_EVERY_DAYS=3
# PROFILE_REMINDER_MAX=8
# MISSED_GRACE_MINUTES=45

# WhatsApp reminders go through the Qwesi backend (needs QWESI_BACKEND_URL + HOSPITAL_DASHBOARD_API_KEY). Set to false to disable.
# WHATSAPP_REMINDERS=true
