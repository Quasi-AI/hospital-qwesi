{
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm install",
  "framework": "nextjs",
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1",
    "NODE_ENV": "production",
    "SKIP_LINTING": "true",
    "SKIP_TYPE_CHECK": "true"
  },
  "crons": [
    {
      "path": "/api/cron/lifecycle",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/notifications/cron",
      "schedule": "0 7 * * *"
    }
  ]
}
